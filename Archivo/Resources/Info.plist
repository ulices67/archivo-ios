  <key>NSPhotoLibraryUsageDescription</key><string>Archivo necesita acceso a las fotos que elijas compartir.</string>
  <key>NSPhotoLibraryAddUsageDescription</key><string>Archivo puede guardar contenido que tú solicites.</string>
  <key>NSLocationWhenInUseUsageDescription</key><string>Tu ubicación permite calcular rutas de mensajes caminando.</string>
  <key>NSMicrophoneUsageDescription</key><string>Archivo usa el micrófono cuando decides enviar audio.</string>
  <key>UIBackgroundModes</key><array><string>remote-notification</string><string>audio</string></array>
  <key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
</dict>
</plist>
